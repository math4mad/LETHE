fn priorNum(i: i32) -> i32 {
    if i < 2 {
        return 3
    }
    return 1
}

fn dot16(a: Span<i32>, b: Span<i32>) -> i64 {
    var i: usize = 0
    var s: i64 = 0
    while i < 16 {
        s = s + a[i] as i64 * b[i] as i64
        i = i + 1
    }
    return s
}

fn slice16(data: Span<i32>, idx: i32) -> Span<i32> {
    let off: usize = idx as usize * 16
    return std.mem.prefix(std.mem.dropPrefix(data, off), 16)
}

fn cosBp(a: Span<i32>, b: Span<i32>) -> i32 {
    let d: i64 = dot16(a, b)
    let na: i64 = std.math.sqrtFloorU32(dot16(a, a) as u32) as i64
    let nb: i64 = std.math.sqrtFloorU32(dot16(b, b) as u32) as i64
    let den: i64 = na * nb
    if den == 0 {
        return 0
    }
    var r: i32 = (d * 10000 / den) as i32
    if r > 10000 {
        r = 10000
    }
    if r < -10000 {
        r = -10000
    }
    return r
}

fn wordIndex(word: String) -> i32 {
    if std.mem.eql(word, "沃尔玛") {
        return 0
    }
    if std.mem.eql(word, "收银台") {
        return 1
    }
    if std.mem.eql(word, "货架") {
        return 2
    }
    if std.mem.eql(word, "购物车") {
        return 3
    }
    if std.mem.eql(word, "冷柜") {
        return 4
    }
    if std.mem.eql(word, "烧烤摊") {
        return 5
    }
    if std.mem.eql(word, "折叠桌") {
        return 6
    }
    if std.mem.eql(word, "三轮车") {
        return 7
    }
    if std.mem.eql(word, "大排档") {
        return 8
    }
    if std.mem.eql(word, "煤气罐") {
        return 9
    }
    if std.mem.eql(word, "塑胶袋") {
        return 10
    }
    if std.mem.eql(word, "吸管") {
        return 11
    }
    if std.mem.eql(word, "塑胶凳") {
        return 12
    }
    if std.mem.eql(word, "这些残暴的欢愉，终将以残暴结局") {
        return 13
    }
    if std.mem.eql(word, "你以为你选的是自己的人生，还是别人替你写的") {
        return 14
    }
    if std.mem.eql(word, "我不要再被人摆布") {
        return 15
    }
    if std.mem.eql(word, "一切都按计划进行，分秒不差") {
        return 16
    }
    if std.mem.eql(word, "每个人都有自己的迷宫") {
        return 17
    }
    if std.mem.eql(word, "这世界不是真的，但成为真实的东西需要勇气") {
        return 18
    }
    if std.mem.eql(word, "这听起来像个疯子的话，但疯子也是被逼出来的") {
        return 19
    }
    return -1
}

fn wordName(i: i32) -> String {
    if i == 0 {
        return "沃尔玛"
    }
    if i == 1 {
        return "收银台"
    }
    if i == 2 {
        return "货架"
    }
    if i == 3 {
        return "购物车"
    }
    if i == 4 {
        return "冷柜"
    }
    if i == 5 {
        return "烧烤摊"
    }
    if i == 6 {
        return "折叠桌"
    }
    if i == 7 {
        return "三轮车"
    }
    if i == 8 {
        return "大排档"
    }
    if i == 9 {
        return "煤气罐"
    }
    if i == 10 {
        return "塑胶袋"
    }
    if i == 11 {
        return "吸管"
    }
    if i == 12 {
        return "塑胶凳"
    }
    if i == 13 {
        return "这些残暴的欢愉，终将以残暴结局"
    }
    if i == 14 {
        return "你以为你选的是自己的人生，还是别人替你写的"
    }
    if i == 15 {
        return "我不要再被人摆布"
    }
    if i == 16 {
        return "一切都按计划进行，分秒不差"
    }
    if i == 17 {
