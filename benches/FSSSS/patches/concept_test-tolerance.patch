 import cs.cs as cs
 
 class TestConcept(unittest.TestCase):
+
+    def _num_approx(self, a, b, delta=1e-6):
+        import math
+        if isinstance(a, (list, tuple)):
+            self.assertEqual(len(a), len(b))
+            for x, y in zip(a, b):
+                self._num_approx(x, y, delta)
+        elif isinstance(a, dict):
+            self.assertEqual(set(a.keys()), set(b.keys()))
+            for k in a:
+                self._num_approx(a[k], b[k], delta)
+        else:
+            if math.isinf(a) or math.isinf(b):
+                self.assertEqual(a, b)
+            else:
+                self.assertAlmostEqual(a, b, delta=delta)
+
+    def assertConceptApprox(self, actual, expected, delta=1e-6):
+        """Tolerant concept comparison. Exact float equality on scipy optimizer
+        output is brittle across scipy versions (see benches/FSSSS)."""
+        self.assertAlmostEqual(actual._mu, expected._mu, delta=delta)
+        self.assertAlmostEqual(actual._c, expected._c, delta=delta)
+        self._num_approx(actual._weights._domain_weights, expected._weights._domain_weights, delta)
+        self._num_approx(actual._weights._dimension_weights, expected._weights._dimension_weights, delta)
+        self.assertEqual(len(actual._core._cuboids), len(expected._core._cuboids))
+        for x, y in zip(actual._core._cuboids, expected._core._cuboids):
+            self.assertEqual(x._domains, y._domains)
+            self._num_approx(x._p_min, y._p_min, delta)
+            self._num_approx(x._p_max, y._p_max, delta)
 
